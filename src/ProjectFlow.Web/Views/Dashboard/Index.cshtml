@model ProjectFlow.Core.DTOs.DashboardDto
@{ ViewData["Title"] = "Dashboard"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="eyebrow">Your workspace pulse</p><h1>Overview</h1><p class="text-muted">A clear view of work you have access to. Planning dates use UTC.</p></div><a class="btn btn-primary" asp-controller="Projects" asp-action="Create">New project</a></div>
<div class="row g-3 mb-4">
@foreach (var metric in new[] { ("Projects", Model.TotalProjects), ("Active projects", Model.ActiveProjects), ("Tasks", Model.TotalTasks), ("To do", Model.PendingTasks), ("In progress / review", Model.InProgressTasks), ("Completed", Model.CompletedTasks), ("Overdue", Model.OverdueTasks) }) { <div class="col-6 col-lg-3"><article class="card h-100"><div class="card-body"><p class="text-muted small mb-1">@metric.Item1</p><strong class="display-6">@metric.Item2</strong></div></article></div> }
</div><div class="row g-4"><section class="col-lg-5"><div class="card h-100"><div class="card-body"><h2 class="h4">Due in the next 7 days</h2>@foreach (var t in Model.Upcoming) { <div class="border-bottom py-3"><a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id">@t.Title</a><p class="text-muted small mb-0">@t.ProjectName · @t.DueDate.ToString("dd MMM") · @t.AssigneeName</p></div> }@if (Model.Upcoming.Count == 0) { <p class="text-muted mt-3">No upcoming open tasks.</p> }<a class="btn btn-sm btn-outline-primary mt-3" asp-controller="Tasks" asp-action="Index" asp-route-mine="true">View my tasks</a></div></div></section>
<section class="col-lg-7"><div class="card h-100"><div class="card-body"><h2 class="h4">Recent activity</h2>@foreach (var a in Model.Recent.Take(8)) { <div class="border-bottom py-2"><a asp-controller="Projects" asp-action="Details" asp-route-id="@a.ProjectId">@a.ProjectName</a><p class="mb-0">@a.ActorName · @a.Description</p><small class="text-muted">@a.CreatedAt.ToString("dd MMM HH:mm 'UTC'")</small></div> }@if (Model.Recent.Count == 0) { <p class="text-muted">Your project activity will appear here.</p> }<a class="btn btn-sm btn-outline-primary mt-3" asp-action="Activity">All activity</a></div></div></section></div>
<section class="card mt-4"><div class="card-body"><h2 class="h4">Task status</h2><div class="d-flex flex-wrap gap-3">@foreach (var s in Model.Statuses) { <span>@s.Status <strong class="badge text-bg-primary">@s.Count</strong></span> }</div></div></section>
