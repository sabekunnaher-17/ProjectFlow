@model ProjectFlow.Core.DTOs.PageDto<ProjectFlow.Core.DTOs.ActivityDto>
@{ ViewData["Title"] = "Activity history"; }
<h1>Activity history</h1><p class="text-muted">Events are recorded with the actual actor and UTC timestamp.</p>
<div class="card"><div class="card-body">@foreach (var a in Model.Items) { <article class="border-bottom py-3"><div class="d-flex justify-content-between"><a asp-controller="Projects" asp-action="Details" asp-route-id="@a.ProjectId">@a.ProjectName</a><time>@a.CreatedAt.ToString("u")</time></div><p class="mb-0">@a.ActorName · @a.Description</p>@if (a.TaskItemId.HasValue) { <a class="small" asp-controller="Tasks" asp-action="Details" asp-route-id="@a.TaskItemId">Open task</a> }</article> }@if (Model.Total == 0) { <p>No activity yet.</p> }</div></div>
<nav class="d-flex gap-3 mt-3" aria-label="Activity pages">@if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)" asp-route-projectId="@ViewData["ProjectId"]">Previous</a> }<span>@Model.Total events</span>@if (Model.Page < Model.Pages) { <a asp-route-page="@(Model.Page + 1)" asp-route-projectId="@ViewData["ProjectId"]">Next</a> }</nav>
