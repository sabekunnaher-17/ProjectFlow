@using ProjectFlow.Core.DTOs
@using ProjectFlow.Core.Enums
@model ProjectRequest
@{ var editing = ViewData["Id"] is Guid; var org = (OrganizationDto)ViewData["Organization"]!; ViewData["Title"] = editing ? "Edit project" : "New project"; }
<h1>@ViewData["Title"]</h1><p class="text-muted">Workspace: @org.Name</p>
@if (!editing && ViewData["Organizations"] is IReadOnlyList<OrganizationDto> orgs) { <div class="mb-3">Switch workspace: @foreach (var o in orgs) { <a class="me-3" asp-action="Create" asp-route-organizationId="@o.Id">@o.Name</a> }</div> }
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@ViewData["Id"]" method="post" class="card"><div class="card-body">
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="OrganizationId" type="hidden" /><input asp-for="Version" type="hidden" />
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required minlength="2" maxlength="120" /></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4" maxlength="3000"></textarea></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="ManagerId" class="form-label">Project manager</label><select asp-for="ManagerId" class="form-select" required>@foreach (var m in org.Members) { <option value="@m.Id">@m.DisplayName</option> }</select></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ProjectStatus>()" class="form-select"></select></div><div class="col-md-6"><label asp-for="StartDate" class="form-label">Start date</label><input asp-for="StartDate" type="date" class="form-control" required /></div><div class="col-md-6"><label asp-for="EndDate" class="form-label">End date</label><input asp-for="EndDate" type="date" class="form-control" required /></div></div>
<div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save project</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></div></form>
