@using ProjectFlow.Core.DTOs
@using ProjectFlow.Core.Enums
@model ProjectDto
@{ ViewData["Title"] = Model.Name; }
<a asp-action="Index">Projects</a><div class="d-flex justify-content-between align-items-start mt-3"><div><p class="eyebrow">@Model.OrganizationName · @Model.Status</p><h1>@Model.Name</h1><p class="text-muted">Managed by @Model.ManagerName · @Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy")</p></div>
@if (Model.CanManage && Model.Status != ProjectStatus.Archived) { <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit project</a> }</div>
<p class="preserve-lines">@Model.Description</p><label for="project-progress">@Model.Progress% complete</label><progress id="project-progress" class="w-100 mb-4" max="100" value="@Model.Progress">@Model.Progress%</progress>
<section class="card"><div class="card-body"><h2 class="h4">Project members</h2><ul class="list-group list-group-flush">@foreach (var m in Model.Members) { <li class="list-group-item d-flex justify-content-between align-items-center"><span>@m.DisplayName <small class="text-muted">@m.Email</small></span>@if (Model.CanManage && Model.Status != ProjectStatus.Archived && m.Id != Model.ManagerId) { <form asp-action="Member" asp-route-id="@Model.Id" method="post" data-confirm="Remove this project member?"><input type="hidden" name="UserId" value="@m.Id" /><input type="hidden" name="Version" value="@Model.Version" /><input type="hidden" name="remove" value="true" /><button class="btn btn-sm btn-outline-danger">Remove</button></form> }</li> }</ul>
@if (Model.CanManage && Model.Status != ProjectStatus.Archived && ViewData["Organization"] is OrganizationDto org) { <form asp-action="Member" asp-route-id="@Model.Id" method="post" class="mt-3"><input type="hidden" name="Version" value="@Model.Version" /><label for="new-member" class="form-label">Add organization member</label><div class="input-group"><select id="new-member" name="UserId" class="form-select" required><option value="">Choose a member</option>@foreach (var m in org.Members.Where(m => !Model.Members.Any(p => p.Id == m.Id))) { <option value="@m.Id">@m.DisplayName</option> }</select><button class="btn btn-outline-primary">Add member</button></div></form> }
</div></section>
@if (Model.CanManage && Model.Status != ProjectStatus.Archived) { <form asp-action="Archive" asp-route-id="@Model.Id" method="post" class="mt-4" data-confirm="Archive this project? It will become read-only."><input type="hidden" name="Version" value="@Model.Version" /><button class="btn btn-outline-danger">Archive project</button></form> }
