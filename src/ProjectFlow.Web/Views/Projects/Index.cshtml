@using ProjectFlow.Core.DTOs
@using ProjectFlow.Core.Enums
@model PageDto<ProjectDto>
@{ ViewData["Title"] = "Projects"; var q = (ProjectQuery)ViewData["Query"]!; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="eyebrow">Move work forward</p><h1>Projects</h1></div><a asp-action="Create" class="btn btn-primary">New project</a></div>
<form method="get" class="row g-2 mb-4"><input type="hidden" name="OrganizationId" value="@q.OrganizationId" /><div class="col-sm-6"><label for="keyword" class="visually-hidden">Search projects</label><input id="keyword" name="Keyword" value="@q.Keyword" class="form-control" placeholder="Search projects" maxlength="120" /></div><div class="col-sm-4"><label for="status" class="visually-hidden">Status</label><select id="status" name="Status" class="form-select"><option value="">All statuses</option>@foreach (var s in Enum.GetValues<ProjectStatus>()) { <option value="@s" selected="@(q.Status == s)">@s</option> }</select></div><div class="col-sm-2"><button class="btn btn-outline-primary w-100">Filter</button></div></form>
<div class="row g-3">@foreach (var p in Model.Items) { <div class="col-md-6 col-xl-4"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><small class="text-muted">@p.OrganizationName</small><span class="badge text-bg-light">@p.Status</span></div><h2 class="h5 my-3"><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a></h2><p class="text-muted">@p.ManagerName · Due @p.EndDate.ToString("dd MMM yyyy")</p><label class="small" for="progress-@p.Id">@p.Progress% complete</label><progress id="progress-@p.Id" value="@p.Progress" max="100" class="w-100">@p.Progress%</progress></div></article></div> }</div>
@if (Model.Total == 0) { <div class="card p-4 text-muted">No matching projects. Create a workspace and project to get started.</div> }
<nav aria-label="Project pages" class="d-flex gap-3 mt-4">@if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)" asp-route-keyword="@q.Keyword" asp-route-status="@q.Status" asp-route-organizationId="@q.OrganizationId">Previous</a> }<span>@Model.Total projects · Page @Model.Page of @Math.Max(1, Model.Pages)</span>@if (Model.Page < Model.Pages) { <a asp-route-page="@(Model.Page + 1)" asp-route-keyword="@q.Keyword" asp-route-status="@q.Status" asp-route-organizationId="@q.OrganizationId">Next</a> }</nav>
