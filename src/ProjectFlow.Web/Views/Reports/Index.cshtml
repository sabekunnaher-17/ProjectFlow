@using ProjectFlow.Core.DTOs
@using ProjectFlow.Core.Enums
@using TaskState = ProjectFlow.Core.Enums.TaskStatus
@model PageDto<TaskDto>
@{ ViewData["Title"] = "Reports"; var q = (TaskQuery)ViewData["Query"]!; }
<h1>Task report</h1><p class="text-muted">Export up to 5,000 authorized tasks. Narrow filters when a report is larger. CSV cells are protected against spreadsheet formula injection.</p>
<form method="get" class="card p-3 mb-4"><div class="row g-3"><div class="col-md-4"><label for="keyword" class="form-label">Keyword</label><input id="keyword" name="Keyword" value="@q.Keyword" class="form-control" maxlength="160" /></div><div class="col-md-4"><label for="status" class="form-label">Status</label><select id="status" name="Status" class="form-select"><option value="">All</option>@foreach (var s in Enum.GetValues<TaskState>()) { <option value="@s" selected="@(q.Status == s)">@s</option> }</select></div><div class="col-md-4"><label for="priority" class="form-label">Priority</label><select id="priority" name="Priority" class="form-select"><option value="">All</option>@foreach (var s in Enum.GetValues<TaskPriority>()) { <option value="@s" selected="@(q.Priority == s)">@s</option> }</select></div><div class="col-md-4"><label for="from" class="form-label">Due from</label><input id="from" name="From" type="date" value="@q.From?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-4"><label for="to" class="form-label">Due through</label><input id="to" name="To" type="date" value="@q.To?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-4 d-flex align-items-end gap-2"><button class="btn btn-primary">Preview</button><button class="btn btn-outline-primary" asp-action="Export">Download CSV</button></div></div></form>
<p>@Model.Total matching tasks. Preview page @Model.Page of @Math.Max(1, Model.Pages).</p><div class="table-responsive card"><table class="table mb-0"><thead><tr><th>Task</th><th>Project</th><th>Assignee</th><th>Status</th><th>Due</th></tr></thead><tbody>@foreach (var t in Model.Items) { <tr><td><a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id">@t.Title</a></td><td>@t.ProjectName</td><td>@t.AssigneeName</td><td>@t.Status</td><td>@t.DueDate.ToString("yyyy-MM-dd")</td></tr> }</tbody></table></div>
<nav class="d-flex gap-3 mt-3" aria-label="Report pages">@if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)" asp-route-keyword="@q.Keyword" asp-route-status="@q.Status" asp-route-priority="@q.Priority" asp-route-from="@q.From?.ToString("yyyy-MM-dd")" asp-route-to="@q.To?.ToString("yyyy-MM-dd")">Previous</a> }@if (Model.Page < Model.Pages) { <a asp-route-page="@(Model.Page + 1)" asp-route-keyword="@q.Keyword" asp-route-status="@q.Status" asp-route-priority="@q.Priority" asp-route-from="@q.From?.ToString("yyyy-MM-dd")" asp-route-to="@q.To?.ToString("yyyy-MM-dd")">Next</a> }</nav>
