@using ProjectFlow.Core.DTOs
@using ProjectFlow.Core.Enums
@using TaskState = ProjectFlow.Core.Enums.TaskStatus
@model PageDto<TaskDto>
@{ ViewData["Title"] = "Tasks"; var q = (TaskQuery)ViewData["Query"]!; var board = ViewData["Board"] is true; var project = ViewData["Project"] as ProjectDto; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="eyebrow">@(project?.Name ?? (q.Mine ? "Assigned to you" : "Your work at a glance"))</p><h1>@(board ? "Kanban board" : "Tasks")</h1></div>
@if (project?.CanManage == true && project.Status is not ProjectStatus.Archived and not ProjectStatus.Completed) { <a class="btn btn-primary" asp-action="Create" asp-route-projectId="@project.Id">New task</a> }</div>
<div class="d-flex flex-wrap gap-2 mb-3"><a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-projectId="@q.ProjectId">All tasks</a><a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-projectId="@q.ProjectId" asp-route-mine="true">My tasks</a><a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-projectId="@q.ProjectId" asp-route-mine="@q.Mine" asp-route-board="@(!board)">@(board ? "Table view" : "Board view")</a></div>
<form method="get" class="card p-3 mb-4"><input type="hidden" name="ProjectId" value="@q.ProjectId" /><input type="hidden" name="Mine" value="@q.Mine.ToString().ToLowerInvariant()" /><input type="hidden" name="board" value="@board.ToString().ToLowerInvariant()" /><div class="row g-3">
<div class="col-md-4"><label for="keyword" class="form-label">Search</label><input id="keyword" name="Keyword" value="@q.Keyword" class="form-control" maxlength="160" placeholder="Task title or description" /></div>
<div class="col-md-2"><label for="status-filter" class="form-label">Status</label><select id="status-filter" name="Status" class="form-select"><option value="">Any</option>@foreach (var s in Enum.GetValues<TaskState>()) { <option value="@s" selected="@(q.Status == s)">@s</option> }</select></div>
<div class="col-md-2"><label for="priority" class="form-label">Priority</label><select id="priority" name="Priority" class="form-select"><option value="">Any</option>@foreach (var s in Enum.GetValues<TaskPriority>()) { <option value="@s" selected="@(q.Priority == s)">@s</option> }</select></div>
<div class="col-md-2"><label for="sort" class="form-label">Sort</label><select id="sort" name="Sort" class="form-select"><option value="due" selected="@(q.Sort == "due")">Due date</option><option value="priority" selected="@(q.Sort == "priority")">Priority</option><option value="title" selected="@(q.Sort == "title")">Title</option></select></div>
<div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100">Apply</button></div>
<div class="col-sm-4"><label for="from" class="form-label">Due from</label><input id="from" name="From" type="date" value="@q.From?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-sm-4"><label for="to" class="form-label">Due through</label><input id="to" name="To" type="date" value="@q.To?.ToString("yyyy-MM-dd")" class="form-control" /></div>
<div class="col-sm-4 d-flex align-items-end pb-2"><div class="form-check"><input id="overdue" name="Overdue" type="checkbox" value="true" checked="@q.Overdue" class="form-check-input" /><label for="overdue" class="form-check-label">Only overdue</label></div></div>
@if (project is not null) { <div class="col-sm-6"><label for="assignee" class="form-label">Assignee</label><select id="assignee" name="AssigneeId" class="form-select"><option value="">Any member</option>@foreach (var m in project.Members) { <option value="@m.Id" selected="@(q.AssigneeId == m.Id)">@m.DisplayName</option> }</select></div> }
</div></form>
@if (Model.Total == 0) { <div class="card p-4 text-muted">No matching tasks. Project managers can create tasks from a project.</div> }
else if (board) {
<p class="small text-muted">Board shows this page of filtered results. Use pagination for more tasks.</p><div class="kanban-board">
@foreach (var status in Enum.GetValues<TaskState>()) { <section class="kanban-column"><h2 class="h6">@status <span class="badge text-bg-secondary">@Model.Items.Count(x => x.Status == status)</span></h2>@foreach (var t in Model.Items.Where(x => x.Status == status)) { <article class="card mb-3"><div class="card-body"><small class="text-muted">@t.Priority · @t.ProjectName</small><h3 class="h6 mt-2"><a asp-action="Details" asp-route-id="@t.Id">@t.Title</a></h3><p class="small mb-0">@t.AssigneeName · @t.DueDate.ToString("dd MMM")</p>@if (t.Overdue) { <span class="badge text-bg-danger mt-2">Overdue</span> }</div></article> }</section> }</div>
} else {
<div class="table-responsive card"><table class="table table-hover align-middle mb-0"><thead><tr><th>Task</th><th>Project</th><th>Assignee</th><th>Priority</th><th>Status</th><th>Due</th></tr></thead><tbody>@foreach (var t in Model.Items) { <tr><td><a asp-action="Details" asp-route-id="@t.Id">@t.Title</a></td><td><a asp-controller="Projects" asp-action="Details" asp-route-id="@t.ProjectId">@t.ProjectName</a></td><td>@t.AssigneeName</td><td>@t.Priority</td><td><span class="badge text-bg-light">@t.Status</span></td><td class="@(t.Overdue ? "text-danger fw-semibold" : "")">@t.DueDate.ToString("dd MMM yyyy")</td></tr> }</tbody></table></div>
}
<nav aria-label="Task pages" class="d-flex gap-3 mt-4">@if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)" asp-route-projectId="@q.ProjectId" asp-route-keyword="@q.Keyword" asp-route-status="@q.Status" asp-route-priority="@q.Priority" asp-route-assigneeId="@q.AssigneeId" asp-route-mine="@q.Mine" asp-route-overdue="@q.Overdue" asp-route-from="@q.From?.ToString("yyyy-MM-dd")" asp-route-to="@q.To?.ToString("yyyy-MM-dd")" asp-route-sort="@q.Sort" asp-route-board="@board">Previous</a> }<span>@Model.Total tasks · Page @Model.Page of @Math.Max(1, Model.Pages)</span>@if (Model.Page < Model.Pages) { <a asp-route-page="@(Model.Page + 1)" asp-route-projectId="@q.ProjectId" asp-route-keyword="@q.Keyword" asp-route-status="@q.Status" asp-route-priority="@q.Priority" asp-route-assigneeId="@q.AssigneeId" asp-route-mine="@q.Mine" asp-route-overdue="@q.Overdue" asp-route-from="@q.From?.ToString("yyyy-MM-dd")" asp-route-to="@q.To?.ToString("yyyy-MM-dd")" asp-route-sort="@q.Sort" asp-route-board="@board">Next</a> }</nav>
