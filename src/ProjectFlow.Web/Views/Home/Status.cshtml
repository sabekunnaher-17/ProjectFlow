@model int
@{ ViewData["Title"] = Model == 404 ? "Page not found" : "Request unavailable"; }
<section class="auth-card card mx-auto my-5"><div class="card-body p-5"><p class="eyebrow">ProjectFlow · @Model</p><h1 class="h3">@ViewData["Title"]</h1><p class="text-muted">The page may have moved, or your access may have changed. Check the address and try again.</p><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return home</a></div></section>
