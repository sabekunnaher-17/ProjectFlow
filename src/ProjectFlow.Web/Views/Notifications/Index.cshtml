@model ProjectFlow.Core.DTOs.PageDto<ProjectFlow.Core.DTOs.NotificationDto>
@{ ViewData["Title"] = "Notifications"; var unread = ViewData["Unread"] is true; }
<h1>Notifications</h1><p class="text-muted">Assignments, work updates, comments and deadlines from your projects.</p><div class="d-flex gap-2 mb-4"><a class="btn btn-outline-primary" asp-action="Index">All</a><a class="btn btn-outline-primary" asp-action="Index" asp-route-unread="true">Unread</a></div>
<div class="card"><div class="card-body">@foreach (var n in Model.Items) { <article class="border-bottom py-3 d-flex justify-content-between gap-3"><div><p class="mb-1">@if (!n.ReadAt.HasValue) { <span class="badge text-bg-primary me-2">New</span> }@n.Message</p><small class="text-muted">@n.CreatedAt.ToString("dd MMM yyyy HH:mm 'UTC'")</small>@if (n.TaskItemId.HasValue) { <a class="ms-3" asp-controller="Tasks" asp-action="Details" asp-route-id="@n.TaskItemId">View task</a> }</div>@if (!n.ReadAt.HasValue) { <form asp-action="Read" asp-route-id="@n.Id" method="post"><button class="btn btn-sm btn-outline-secondary">Mark read</button></form> }</article> }@if (Model.Total == 0) { <p class="text-muted mb-0">You're all caught up.</p> }</div></div>
<nav class="d-flex gap-3 mt-3" aria-label="Notification pages">@if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)" asp-route-unread="@unread">Previous</a> }<span>@Model.Total notifications</span>@if (Model.Page < Model.Pages) { <a asp-route-page="@(Model.Page + 1)" asp-route-unread="@unread">Next</a> }</nav>
