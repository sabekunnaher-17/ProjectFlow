@using ProjectFlow.Core.Enums
@model ProjectFlow.Core.DTOs.PageDto<ProjectFlow.Core.DTOs.AdminUserDto>
@{ ViewData["Title"] = "Administration"; }
<h1>User administration</h1><p class="text-muted">Role or activation changes invalidate existing sessions. The last active administrator is protected.</p>
<form method="get" class="d-flex gap-2 mb-4"><label for="keyword" class="visually-hidden">Search users</label><input id="keyword" name="keyword" value="@ViewData["Keyword"]" class="form-control" placeholder="Search name or email" maxlength="100" /><button class="btn btn-outline-primary">Search</button></form>
<div class="row g-3">@foreach (var u in Model.Items) { var currentRole = u.Roles.Contains(Roles.Admin) ? Roles.Admin : u.Roles.Contains(Roles.Manager) ? Roles.Manager : Roles.Member; <section class="col-lg-6"><div class="card h-100"><div class="card-body"><h2 class="h5">@u.DisplayName</h2><p class="text-muted">@u.Email · @(u.IsActive ? "Active" : "Inactive")</p><form asp-action="Update" asp-route-id="@u.Id" method="post" data-confirm="Change this user's access and invalidate their sessions?"><input type="hidden" name="ConcurrencyStamp" value="@u.ConcurrencyStamp" /><label for="role-@u.Id" class="form-label">Role</label><select id="role-@u.Id" name="Role" class="form-select mb-3">@foreach (var r in Roles.All) { <option value="@r" selected="@(currentRole == r)">@r</option> }</select><div class="form-check mb-3"><input id="active-@u.Id" name="IsActive" type="checkbox" value="true" checked="@u.IsActive" class="form-check-input" /><label for="active-@u.Id" class="form-check-label">Account active</label></div><input type="hidden" name="IsActive" value="false" /><button class="btn btn-primary">Save access</button></form></div></div></section> }</div>
<nav class="d-flex gap-3 mt-3" aria-label="User pages">@if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)" asp-route-keyword="@ViewData["Keyword"]">Previous</a> }<span>@Model.Total accounts</span>@if (Model.Page < Model.Pages) { <a asp-route-page="@(Model.Page + 1)" asp-route-keyword="@ViewData["Keyword"]">Next</a> }</nav>
