@model ErrorViewModel
@{ ViewData["Title"] = "Request unavailable"; }
<section class="auth-card card mx-auto my-5"><div class="card-body p-4"><h1 class="h3">We couldn't complete that request</h1><p class="text-muted">Please try again. If the issue persists, share the reference below with your application operator.</p>@if (Model.ShowRequestId) { <p>Reference: <code>@Model.RequestId</code></p> }<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return home</a></div></section>
