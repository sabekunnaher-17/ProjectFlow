@model ProjectFlow.Core.DTOs.RegisterRequest
@{ ViewData["Title"] = "Create account"; }
<section class="auth-card card shadow-sm mx-auto"><div class="card-body p-4">
<p class="text-uppercase small text-primary fw-bold">Get organized</p><h1 class="h3">Create your account</h1>
<p class="text-muted">A focused space for your projects and team.</p>
<form asp-action="Register" method="post">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="DisplayName" class="form-label">Full name</label><input asp-for="DisplayName" class="form-control" autocomplete="name" required minlength="2" maxlength="100" /></div>
<div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" autocomplete="email" required maxlength="254" /></div>
<div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" required minlength="12" maxlength="128" /><div class="form-text">12–128 characters, including upper/lowercase, a number and a symbol.</div></div>
<button class="btn btn-primary w-100">Create account</button>
</form><p class="mt-3 mb-0">Already registered? <a asp-action="Login">Sign in</a></p>
</div></section>
